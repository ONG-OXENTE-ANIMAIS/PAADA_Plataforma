# PAADA_Plataforma - Environment Variables
# Copie para .env e preencha os valores

# ============================================
# SUPABASE (obrigatório)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=campanhas

# ============================================
# EFI / Banco Efí (obrigatório para doações - Pix)
# ============================================
# Credenciais OAuth da aplicação Efi (sandbox ou produção)
EFI_CLIENT_ID=SEU_CLIENT_ID
EFI_CLIENT_SECRET=SEU_CLIENT_SECRET
# Chave Pix cadastrada na Efi (CNPJ, CPF, e-mail, telefone ou chave aleatória)
EFI_PIX_KEY=SUA_CHAVE_PIX
# Efi_SANDBOX=false para produção
EFI_SANDBOX=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# AUTH (obrigatório)
# ============================================
# Gere com: openssl rand -base64 32
AUTH_SECRET=seu-secret-super-seguro-aqui

# ============================================
# OPCIONAIS
# ============================================
# NODE_ENV=development
# NEXT_TELEMETRY_DISABLED=1