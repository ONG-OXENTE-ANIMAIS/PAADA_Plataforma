# PAADA_Plataforma - Environment Variables
# Copie para .env e preencha os valores

# ============================================
# SUPABASE (obrigatório)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=campanhas

# ============================================
# MERCADO PAGO (obrigatório para doações)
# ============================================
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
MERCADO_PAGO_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# AUTH (obrigatório)
# ============================================
# Gere com: openssl rand -base64 32
AUTH_SECRET=seu-secret-super-seguro-aqui

# ============================================
# OPCIONAIS
# ============================================
# NODE_ENV=development
# NEXT_TELEMETRY_DISABLED=1